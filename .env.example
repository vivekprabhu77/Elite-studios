# Cloudflare R2 Bucket Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_BUCKET_NAME="portfolio"

# R2 S3 API Credentials (Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID="your_32_character_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_64_character_r2_secret_access_key"

# (Optional) Public domain for R2 bucket
# R2_PUBLIC_URL="https://pub-youraccountid.r2.dev"
